{
  "name": "teochew-dictionary",
  "version": "0.1.0",
  "private": true,
  "description": "A structured, openly-licensed Teochew (潮州話) lexicon with romanization tooling",
  "license": "BSD-3-Clause",
  "author": "John Ky",
  "repository": {
    "type": "git",
    "url": "https://github.com/teochew-works/teochew-dictionary.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx src/cli/validate.ts",
    "build": "tsx src/cli/build.ts",
    "import": "tsx src/cli/import.ts",
    "backfill:wiktionary-tags": "tsx src/cli/backfill-wiktionary-tags.ts",
    "backfill:mandarin-level": "tsx src/cli/backfill-mandarin-level.ts",
    "inventory": "tsx src/cli/inventory.ts",
    "wordlist:wiktionary": "tsx src/cli/wiktionary-index.ts",
    "batch:wiktionary": "tsx src/cli/wiktionary-batch.ts",
    "cache:wiktionary": "tsx src/cli/wiktionary-page-cache.ts",
    "xref": "tsx src/cli/xref.ts",
    "lookup": "tsx src/cli/lookup.ts",
    "audio:verify": "tsx src/cli/audio-verify.ts",
    "rehost:lingualibre": "tsx src/cli/lingualibre-rehost.ts",
    "merge:lingualibre": "tsx src/cli/lingualibre-merge.ts",
    "merge:local-recording": "tsx src/cli/local-recording-merge.ts",
    "schema": "tsx src/cli/emit-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run validate"
  },
  "dependencies": {
    "@teochew/core": "file:packages/core",
    "better-sqlite3": "^13.0.3",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
